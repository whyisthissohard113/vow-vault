# ------------------------------------------------------------------
# Wedding Memory Vault — environment variables (copy to .env)
# ------------------------------------------------------------------

# PostgreSQL connection string (standard / pooled Neon URL both supported)
DATABASE_URL=postgresql://wmv:wmv@localhost:5432/wedding_memory_vault

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-64-char-random-string

# App URL used in emails/QR destinations
APP_URL=http://localhost:3000
# Public origin used when the app constructs its own public URLs (QR payloads,
# build-engine destinations, email links, vault display URLs). Server-side code
# reads it at runtime; set both to the same public origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email / SMTP (leave EMAIL_SMTP_HOST empty to use the console provider for dev)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# Default sender used when stepping the onboarding flow is skipped. Emails are
# only ever sent to resolved customer/support addresses — never placeholders.
EMAIL_FROM=noreply@weddingmemoryvault.app
EMAIL_FROM_NAME=Wedding Memory Vault
# Shared secret that the email provider signs delivery webhooks with. The
# webhook route reads this same value; leave empty to accept unsigned webhooks
# in dev (logs a warning each request).
EMAIL_WEBHOOK_SECRET=

# Storage (S3-compatible; MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wmv-dev
S3_ACCESS_KEY_ID=wmv
S3_SECRET_ACCESS_KEY=wmv-secret
S3_FORCE_PATH_STYLE=true

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# PayFast (South African payment gateway)
# PAYFAST_MODE=simulated is the default: checkout redirects to the local
# /api/payments/simulate/<paymentId> simulation and webhooks skip PayFast
# server-side validation (MD5 signature checks still run). Set to "test" or
# "live" and add PAYFAST_VALIDATE_URL / PAYFAST_ITN_URL overrides when
# integrating with the real gateway.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=simulated
PAYFAST_NOTIFY_URL=http://localhost:3000/api/webhooks/payments/payfast
# PAYFAST_VALIDATE_URL=https://www.payfast.co.za/eng/query/validate
# PAYFAST_ITN_URL=https://www.payfast.co.za/eng/process